# yaml-language-server: $schema=https://huacnlee.github.io/autocorrect/schema.json
#
# AutoCorrect configuration for this repository. Imported verbatim from
# `autocorrect init` (.autocorrectrc.template upstream), apart from the two
# overrides marked below.
#
# The `autocorrect` binary comes from the `autocorrect-node` dev dependency, so
# `pnpm install` is all that is needed locally and in CI. Run it with
# `pnpm lint-text` (fix in place) or `pnpm lint-text-check` (report only).
rules:
  # Default rules: https://github.com/huacnlee/autocorrect/raw/main/autocorrect/.autocorrectrc.default
  #
  # Override 1 - space-word inserts a half-width space at every Japanese/Latin
  # boundary (for example, "PDF ファイル"). The 和欧混植 rule in the Japanese style
  # guide forbids that spacing, so the rule is turned off here to stop
  # `pnpm lint` reintroducing it across the Japanese content.
  # See docs/general-style-guide-japanese.md.
  space-word: 0
  #
  # Override 2 - the upstream template ships spellcheck at 2 (warning). It is
  # turned off here because the word list below reaches the `<script setup>`
  # blocks of the VitePress snippets under contents/snippets/, which are live
  # TypeScript rather than fenced code, so the `context.codeblock` setting does
  # not shield them. It rewrites `import * as yaml from 'js-yaml'` to `YAML`
  # without rewriting the `yaml.load` call further down the same file, which
  # breaks the build. Enabling it also flags 46 prose spots, mostly
  # "markdown" -> "Markdown". Protect those call sites before turning it on.
  spellcheck: 0
# Enable or disable in special context
context:
  # Enable or disable to format codeblock in Markdown or AsciiDoc etc.
  codeblock: 1
textRules:
  # Config some special rule for some texts
  # For example, if we wants to let "Hello你好" just warning, and "Hi你好" to ignore
  # "Hello你好": 2
  # "Hi你好": 0
fileTypes:
  # Config the files associations, you config is higher priority than default.
  # "rb": ruby
  # "Rakefile": ruby
  # "*.js": javascript
  # ".mdx": markdown
spellcheck:
