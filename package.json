{
  "name": "tokyo-geek",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vitepress build contents",
    "check": "pnpm run lint-check && pnpm run check-content",
    "check-content": "node scripts/check-content.mjs",
    "check-sitemap": "node scripts/check-sitemap.mjs",
    "claude": "claude",
    "cleanup": "zsh ./scripts/cleanup-temp-files.sh",
    "codex": "codex",
    "cursor": "cursor-agent",
    "dev": "vitepress dev contents",
    "index": "zsh scripts/index.sh",
    "lint": "pnpm run lint-code && pnpm run lint-md && pnpm run lint-text",
    "lint-check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .prettierignore-check && markdownlint-cli2 && pnpm run lint-text-check",
    "lint-code": "prettier --write .",
    "lint-md": "markdownlint-cli2 --fix",
    "lint-naming": "node skills/file-folder-name-linter/scripts/lint-names.mjs",
    "lint-target": "zsh scripts/targeted-linting.sh",
    "lint-text": "autocorrect --fix .",
    "lint-text-check": "autocorrect --lint --strict .",
    "nodenv": "V=\"$(cat .node-version)\" && nodenv install -s \"$V\" && nodenv local \"$V\" && NODENV_VERSION=\"$V\" nodenv exec npm install -g pnpm && nodenv rehash",
    "preview": "vitepress preview contents",
    "test": "pnpm run tree && pnpm run lint-check && pnpm run check-content && vitepress build contents && pnpm run check-sitemap",
    "tree": "node scripts/generate-doc-structure.mjs"
  },
  "devDependencies": {
    "@davidingplus/vitepress-image-viewer": "^1.1.5",
    "@nolebase/vitepress-plugin-enhanced-readabilities": "^2.21.1",
    "@nolebase/vitepress-plugin-meta": "^2.21.1",
    "@prettier/plugin-xml": "^3.4.2",
    "autocorrect-node": "^2.14.0",
    "js-yaml": "^5.5.0",
    "markdownlint-cli2": "^0.24.1",
    "markdownlint-rule-relative-links": "^5.1.4",
    "markdownlint-rule-search-replace": "^1.2.0",
    "prettier": "^3.10.1",
    "prettier-plugin-packagejson": "^3.1.0",
    "prettier-plugin-pkg": "^0.22.1",
    "prettier-plugin-sh": "^0.20.2",
    "prettier-plugin-toml": "^4.1.0",
    "sh-syntax": "^0.8.6",
    "tree-extended": "^4.6.0",
    "vite": "^8.3.8",
    "vitepress": "2.0.0-alpha.20",
    "vitepress-mermaid-renderer": "^1.2.3",
    "vitepress-sidebar": "^1.41.0",
    "vue": "^3.5.45"
  },
  "packageManager": "pnpm@12.21.0"
}
