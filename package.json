{
  "name": "tokyo-geek",
  "version": "1.0.0",
  "license": "CC-BY-4.0",
  "type": "module",
  "scripts": {
    "build": "vitepress build contents",
    "check": "pnpm run lint && vitepress dev contents",
    "dev": "vitepress dev contents",
    "index": "zsh scripts/index.sh",
    "lint": "pnpm run lint-code && pnpm run lint-md",
    "lint-code": "prettier --write .",
    "lint-md": "markdownlint-cli2 --fix",
    "lint-naming": "node skills/file-folder-name-linter/scripts/lint-names.mjs",
    "lint-target": "zsh scripts/targeted-linting.sh",
    "nodenv": "V=\"$(cat .node-version)\" && nodenv install -s \"$V\" && nodenv local \"$V\" && NODENV_VERSION=\"$V\" nodenv exec corepack enable pnpm && nodenv rehash",
    "preview": "vitepress preview contents",
    "test": "pnpm run tree && pnpm run lint && vitepress build contents && vitepress preview contents",
    "tree": "node scripts/generate-doc-structure.mjs"
  },
  "devDependencies": {
    "@davidingplus/vitepress-image-viewer": "^1.1.5",
    "@nolebase/vitepress-plugin-enhanced-readabilities": "^2.18.2",
    "@nolebase/vitepress-plugin-meta": "^2.18.2",
    "@prettier/plugin-xml": "^3.4.2",
    "gray-matter": "^4.0.3",
    "init": "^0.1.2",
    "js-yaml": "^5.3.0",
    "markdown-link-check": "^3.15.0",
    "markdownlint-cli2": "^0.23.2",
    "markdownlint-rule-relative-links": "^5.1.2",
    "markdownlint-rule-search-replace": "^1.2.0",
    "openai": "^7.5.0",
    "prettier": "^3.9.6",
    "prettier-plugin-autocorrect": "^0.4.3",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-pkg": "^0.22.1",
    "prettier-plugin-sh": "^0.19.0",
    "prettier-plugin-toml": "^2.0.6",
    "sh-syntax": "^0.6.0",
    "tree-extended": "^4.6.0",
    "vite": "^8.2.2",
    "vitepress": "2.0.0-alpha.17",
    "vitepress-mermaid-renderer": "^1.2.0",
    "vitepress-sidebar": "^1.39.0",
    "vue": "^3.5.41"
  },
  "packageManager": "pnpm@11.6.0"
}
