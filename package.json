{
  "name": "tokyo-geek",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vitepress build contents",
    "check": "pnpm run lint-check && pnpm run check-content",
    "check-content": "node scripts/check-content.mjs",
    "check-sitemap": "node scripts/check-sitemap.mjs",
    "claude": "claude",
    "cleanup": "zsh ./scripts/cleanup-temp-files.sh",
    "codex": "codex",
    "cursor": "cursor-agent",
    "dev": "vitepress dev contents",
    "index": "zsh scripts/index.sh",
    "lint": "pnpm run lint-code && pnpm run lint-md",
    "lint-check": "prettier --check . && markdownlint-cli2",
    "lint-code": "prettier --write .",
    "lint-md": "markdownlint-cli2 --fix",
    "lint-naming": "node skills/file-folder-name-linter/scripts/lint-names.mjs",
    "lint-target": "zsh scripts/targeted-linting.sh",
    "nodenv": "V=\"$(cat .node-version)\" && nodenv install -s \"$V\" && nodenv local \"$V\" && NODENV_VERSION=\"$V\" nodenv exec corepack enable pnpm && nodenv rehash",
    "preview": "vitepress preview contents",
    "test": "pnpm run tree && pnpm run lint-check && pnpm run check-content && vitepress build contents && pnpm run check-sitemap",
    "tree": "node scripts/generate-doc-structure.mjs"
  },
  "devDependencies": {
    "@nolebase/vitepress-plugin-enhanced-readabilities": "^2.18.2",
    "@prettier/plugin-xml": "^3.4.2",
    "js-yaml": "^5.4.2",
    "markdownlint-cli2": "^0.23.3",
    "markdownlint-rule-relative-links": "^5.1.3",
    "markdownlint-rule-search-replace": "^1.2.0",
    "prettier": "^3.9.9",
    "prettier-plugin-autocorrect": "^0.4.3",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-pkg": "^0.22.1",
    "prettier-plugin-sh": "^0.20.2",
    "prettier-plugin-toml": "^3.0.2",
    "sh-syntax": "^0.7.0",
    "tree-extended": "^4.6.0",
    "vite": "^8.3.1",
    "vitepress": "2.0.0-alpha.17",
    "vitepress-sidebar": "^1.40.0",
    "vue": "^3.5.43"
  },
  "packageManager": "pnpm@11.6.0"
}
